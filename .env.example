# Root .env used by docker-compose.yaml. Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# === REQUIRED ===
# Static API key the MCP server presents to the bridge's /auth/login endpoint.
WHATSAPP_API_KEY=

# HMAC secret used to sign the 45-minute JWTs returned from /auth/login.
WHATSAPP_JWT_SECRET=

# Postgres credentials (the compose file creates the `whatsapp` database).
POSTGRES_USER=whatsapp
POSTGRES_PASS=

# === OPTIONAL ===
# Logger level: debug | info | warn | error. Default: info.
LOG_LEVEL=info
# Login rate limit. Format: <count>/<window>, e.g. 10/30s. Default: 5/1m.
AUTH_LOGIN_RATE=
# Forwarded webhook URL for incoming messages (empty disables).
WEBHOOK_URL=
# Bind address / port for the bridge REST API. Empty HOST = all interfaces.
HOST=
PORT=8080

# -----------------------------------------------------------------------------
# Generating the two secrets (any one of these):
#
#   Linux / macOS / Git Bash:   openssl rand -base64 48
#   PowerShell (Windows):       [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   Python (any OS):            python -c "import secrets;print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
